{
  "name": "pob-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing Path of Building Community's calculation engine to LLM clients.",
  "type": "module",
  "bin": {
    "pob-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist/",
    "lua/",
    "README.md",
    "GETTING_STARTED.md",
    "TROUBLESHOOTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/server.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "prepublishOnly": "npm run build",
    "test:paths": "tsx test/paths-test.ts",
    "test:bridge": "tsx test/bridge-test.ts",
    "test:session": "tsx test/session-test.ts",
    "test:server": "tsx test/server-test.ts",
    "test:phase3": "tsx test/phase3-test.ts",
    "test:phase4": "tsx test/phase4-test.ts",
    "test:phase5": "tsx test/phase5-test.ts",
    "test:phase6": "tsx test/phase6-test.ts",
    "test:phase7": "tsx test/phase7-test.ts",
    "test:integrity": "tsx test/state-integrity-test.ts",
    "test:errors": "tsx test/error-handling-test.ts",
    "test:startup": "tsx test/startup-test.ts",
    "test:safety": "tsx test/engine-safety-test.ts",
    "test:config-keys": "tsx test/config-keys-test.ts",
    "test:url": "tsx test/url-loading-test.ts",
    "test:all": "npm run test:paths && npm run test:url && npm run test:bridge && npm run test:session && npm run test:server && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:integrity && npm run test:errors && npm run test:startup && npm run test:safety && npm run test:config-keys"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaAwesomePwner/PathOfBuilding-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/DaAwesomePwner/PathOfBuilding-MCP/issues"
  },
  "homepage": "https://github.com/DaAwesomePwner/PathOfBuilding-MCP#readme",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "path-of-building",
    "poe",
    "llm",
    "anthropic",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
